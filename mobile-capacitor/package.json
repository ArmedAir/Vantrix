{
  "name": "vantrix-mobile-capacitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "android:brand": "python3 scripts/brand-android.py",
    "android:regen": "rm -rf android && cap add android && npm run android:brand && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capacitor/browser": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "types": "src/index.ts"
